# Server Environment Variables (Netlify Functions & Backend)
# Set these in your Netlify site settings: Site configuration > Environment variables
# DO NOT commit actual secrets to version control.
# Never prefix any secret with VITE_

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Administrative Access Allowlist (comma-separated, case-insensitive)
ADMIN_EMAILS=owner@sarinejewelry.com,admin@sarinejewelry.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Client Environment Variables (Firebase Auth & Firestore - Safe for Browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
