# ==============================================================================
# SARINE JEWELLERY E-COMMERCE CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT ENVIRONMENT VARIABLES (Vite / Firebase Hosting - Safe for Browser)
# ------------------------------------------------------------------------------
# In GitHub Actions: Add these as Repository Secrets or build environment variables.
# When deploying to Firebase Hosting, Vite bundles these public identifiers.
# NOTE: Set VITE_FIREBASE_API_KEY to ONLY the 39-character key string (AIzaSy...).
# Do NOT paste the entire `const firebaseConfig = { ... }` snippet into the secret.

VITE_FIREBASE_API_KEY=AIzaSyA4xyqoFxRpLOEkp3ReG6kOp_IdtdbjRCs
VITE_FIREBASE_AUTH_DOMAIN=sarine-cbcce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sarine-cbcce
VITE_FIREBASE_STORAGE_BUCKET=sarine-cbcce.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=970923394635
VITE_FIREBASE_APP_ID=1:970923394635:web:b428060e0d3db6eca2afce
VITE_FIREBASE_MEASUREMENT_ID=G-L2TP9RN8VR

# Backend API Endpoint Base URL (Optional):
# - On Firebase Spark (100% Free): Point to your Netlify functions deployment,
#   e.g.: VITE_API_BASE_URL=https://<your-site>.netlify.app/.netlify/functions
# - On Firebase Blaze: Leave blank or set to /api if rewriting to Cloud Functions
# - Local dev default: /.netlify/functions
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. SERVER ENVIRONMENT VARIABLES (Backend Functions ONLY — NEVER expose to browser)
# ------------------------------------------------------------------------------
# DO NOT commit actual private keys or secrets to version control.
# Never prefix any server secret with VITE_.
# Configure these in your backend hosting provider (e.g., Netlify Site Configuration
# or Google Cloud Secret Manager for Cloud Functions).

# Firebase Admin SDK Credentials (for verifying ID tokens & authoritative DB access)
FIREBASE_PROJECT_ID=sarine-cbcce
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Administrative Access Allowlist (comma-separated, case-insensitive)
ADMIN_EMAILS=owner@sarinejewelry.com,admin@sarinejewelry.com

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS AUTOMATION SECRETS
# ------------------------------------------------------------------------------
# Add this secret in GitHub: Settings > Secrets and variables > Actions
# - FIREBASE_SERVICE_ACCOUNT_SARINE_CBCCE: JSON content of your Google Cloud
#   service account with "Firebase Hosting Admin" role.
